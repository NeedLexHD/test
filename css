/* ═══════════════════════════════════════════════════════════════
   FIX BOUTONS QUANTITÉ (PANIER GUTENBERG / BLOCKS)
   ═══════════════════════════════════════════════════════════════ */

/* On cible la classe exacte des boutons Gutenberg */
button.wc-block-components-quantity-selector__button {
    /* RESET TAILLE */
    padding: 0 !important;
    width: 30px !important;
    height: 34px !important;
    max-width: 30px !important;
    min-height: 0 !important;
    
    /* RESET COULEUR (Tuer le violet) */
    background: #f0f0f0 !important;
    background-image: none !important;
    color: #333 !important;
    border: 1px solid #ccc !important;
    
    /* RESET FORME */
    border-radius: 0 !important;
    box-shadow: none !important;
    
    /* ALIGNEMENT */
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 18px !important;
    line-height: 1 !important;
}

/* Gérer l'état désactivé (quand on est à 1) */
button.wc-block-components-quantity-selector__button:disabled {
    background: #e5e5e5 !important;
    color: #aaa !important;
    opacity: 0.7 !important;
    cursor: not-allowed !important;
}

/* Le champ chiffre au milieu */
input.wc-block-components-quantity-selector__input {
    height: 34px !important;
    padding: 0 !important;
    border-radius: 0 !important;
    border-top: 1px solid #ccc !important;
    border-bottom: 1px solid #ccc !important;
    background: #fff !important;
    font-size: 14px !important;
}

/* Le conteneur global */
.wc-block-components-quantity-selector {
    border-radius: 4px !important;
    overflow: hidden !important;
    border: none !important; /* On gère les bordures sur les boutons */
}
.wc-block-cart-item__remove-link {
    font-size: 14px !important;       /* Taille standard très lisible */
    padding: 8px 15px !important;     /* Un peu plus d'espace, fait plus "bouton" */
    min-height: auto !important;
    line-height: normal !important;
}

/* Décalage vers la droite sur mobile et tablette – panier + checkout */
@media only screen and (max-width: 1024px) {

    body.woocommerce-cart .ast-container,
    body.woocommerce-checkout .ast-container {
        margin-left: 50px !important;     /* ← ajuste ce chiffre */
        margin-right: 10px !important;    /* un peu moins à droite pour équilibrer */
        max-width: calc(100% - 30px) !important;  /* évite que ça déborde */
    }

    /* Si le récapitulatif reste collé */
    .woocommerce-checkout-review-order,
    .cart_totals,
    form.checkout {
        margin-left: 10px !important;
    }
}
/* Cacher uniquement le résumé mobile */
@media (max-width: 768px) {
    .wp-block-woocommerce-checkout-order-summary-block > .wc-block-components-checkout-order-summary__title {
        display: none !important;
    }
    .wp-block-woocommerce-checkout-order-summary-block > .wc-block-components-checkout-order-summary__content {
        display: none !important;
    }
}
/* ═══════════════════════════════════════════════════════════════
   MENU HAMBURGER - Normal à droite et centré verticalement
   ═══════════════════════════════════════════════════════════════ */
.ast-mobile-menu-trigger-minimal,
.menu-toggle,
.main-header-menu-toggle {
    background: transparent !important;   /* pas de background */
    border: none !important;              /* pas de bordure */
    box-shadow: none !important;          /* pas d’ombre */
    filter: none !important;              
    transition: all 0.3s ease !important; /* transition douce */
    position: absolute;                    /* pour le positionner */
    right: 10px;                           /* à droite */
    top: 50%;                              /* centré verticalement */
    transform: translateY(-25%);           /* exact centré */
    font-size: 28px;                       /* taille du burger */
    width: auto;
    height: auto;
    -webkit-tap-highlight-color: transparent !important;
    -webkit-touch-callout: none !important;
}

/* Effets au survol */
.ast-mobile-menu-trigger-minimal:hover,
.menu-toggle:hover,
.main-header-menu-toggle:hover {
    background: transparent !important;  /* toujours pas de background */
    box-shadow: none !important;
    filter: none !important;
}

/* Effets au focus / clic */
.ast-mobile-menu-trigger-minimal:focus,
.menu-toggle:focus,
.main-header-menu-toggle:focus {
    outline: none !important;
    background: transparent !important;  /* retire le background au clic */
    box-shadow: none !important;
    border: none !important;
}
@media (max-width: 768px) {
    .boxtal-modal *,
    .parcel-point-modal *,
    [data-boxtal] * {
        all: revert !important;
        box-sizing: border-box !important;
